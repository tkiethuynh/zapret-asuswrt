#!/bin/sh

# Zapret Control Script for Asuswrt-Merlin
# Target installation path: /jffs/scripts/zapret

CONFIG_FILE="/jffs/addons/zapret/config.json"
PID_DIR="/tmp/var/run"

get_json_val() {
    local key="$1"
    local file="$2"
    [ -f "$file" ] || return 0
    awk -v k="$key" '{
        s = $0
        pat = "\"" k "\"[[:space:]]*:[[:space:]]*\""
        if (match(s, pat)) {
            s = substr(s, RSTART + RLENGTH)
            out = ""
            while (length(s) > 0) {
                c = substr(s, 1, 1)
                if (c == "\\") {
                    out = out substr(s, 2, 1)
                    s = substr(s, 3)
                } else if (c == "\"") {
                    print out
                    exit
                } else {
                    out = out c
                    s = substr(s, 2)
                }
            }
        }
    }' "$file"
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\r\n'
}

is_valid_port() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

count_hosts() {
    local file="$1"
    [ -f "$file" ] || { echo 0; return; }
    local count
    count=$(grep -c -v '^[[:space:]]*\(#\|$\)' "$file" 2>/dev/null)
    echo "${count:-0}"
}

fix_perms() {
    chmod 755 /jffs/addons/zapret /tmp/var/wwwext/zapret 2>/dev/null || true
    chmod 644 /jffs/addons/zapret/* /jffs/addons/custom_settings.txt /tmp/var/wwwext/zapret/* 2>/dev/null || true
    echo "Permissions hardened."
}

log_msg() {
    echo "$1"
    logger -t zapret "$1" 2>/dev/null || true
}

log_err() {
    echo "$1" >&2
    logger -t zapret "$1" 2>/dev/null || true
}

start() {
    mkdir -p "$PID_DIR"
    
    if [ ! -f "$CONFIG_FILE" ]; then
        log_err "Configuration file $CONFIG_FILE not found. Cannot start."
        return 1
    fi
    
    local enabled=$(get_json_val "enabled" "$CONFIG_FILE")
    if [ "$enabled" != "1" ]; then
        log_msg "Zapret is disabled in config.json. Use WebUI to enable."
        return 0
    fi

    local mode=$(get_json_val "mode" "$CONFIG_FILE")

    # Disable Broadcom runner ONLY for nfqws mode to prevent packet flow acceleration conflicts.
    # We keep Broadcom Flow Cache (fc) enabled so software-level fast path offloading still accelerates network traffic.
    if [ "$mode" = "nfqws" ]; then
        if [ -x /bin/runner ]; then
            echo "Disabling Broadcom packet runner..."
            /bin/runner disable 2>/dev/null || true
        fi
    fi
    local tpws_port=$(get_json_val "tpws_port" "$CONFIG_FILE")
    local tpws_args=$(get_json_val "tpws_args" "$CONFIG_FILE")
    local nfqws_queue=$(get_json_val "nfqws_queue" "$CONFIG_FILE")
    local nfqws_args=$(get_json_val "nfqws_args" "$CONFIG_FILE")
    local hostlist_mode=$(get_json_val "hostlist_mode" "$CONFIG_FILE")

    # Wait for USB mount (Entware binaries in /opt/bin)
    local target_bin=""
    if [ "$mode" = "tpws" ]; then
        target_bin="/opt/bin/tpws"
    elif [ "$mode" = "nfqws" ]; then
        target_bin="/opt/bin/nfqws"
    fi

    if [ -n "$target_bin" ]; then
        local wait_count=0
        if [ ! -f "$target_bin" ]; then
            log_msg "Waiting for $target_bin to become available (USB mount)..."
        fi
        while [ ! -f "$target_bin" ] && [ $wait_count -lt 30 ]; do
            echo "Waiting for $target_bin to become available (USB mount)..."
            sleep 1
            wait_count=$((wait_count+1))
        done

        if [ ! -f "$target_bin" ]; then
            log_err "Error: $target_bin not found after 30 seconds. Cannot start."
            return 1
        fi
    fi

    # Self-heal WebUI mount/config if another boot action or httpd event cleared /tmp/menuTree.js
    if ! grep -q 'tabName: "Zapret"' /www/require/modules/menuTree.js 2>/dev/null || [ ! -f /tmp/var/wwwext/zapret/config.js ]; then
        log_msg "WebUI entry or config.js missing during start; re-injecting WebUI..."
        webui >/dev/null 2>&1 || true
    fi
    
    local hostlist_arg=""
    if [ "$hostlist_mode" = "custom" ]; then
        local valid_hosts=$(count_hosts "/jffs/addons/zapret/hostlist.txt")
        if [ "$valid_hosts" -eq 0 ] 2>/dev/null || [ -z "$valid_hosts" ]; then
            local bak_hosts=$(count_hosts "/jffs/addons/zapret/hostlist.txt.bak")
            if [ "$bak_hosts" -gt 0 ] 2>/dev/null; then
                echo "Notice: Restoring /jffs/addons/zapret/hostlist.txt from backup..."
                cp -f /jffs/addons/zapret/hostlist.txt.bak /jffs/addons/zapret/hostlist.txt
                valid_hosts=$bak_hosts
            fi
        fi
        if [ "$valid_hosts" -eq 0 ] 2>/dev/null || [ -z "$valid_hosts" ]; then
            echo "Error: hostlist_mode is custom, but /jffs/addons/zapret/hostlist.txt is missing or empty. Aborting to protect network traffic." >&2
            logger -t zapret "Error: hostlist_mode is custom but hostlist.txt is missing or empty (0 valid lines). Aborting start to prevent global desync."
            stop >/dev/null 2>&1 || true
            return 1
        fi
        hostlist_arg="--hostlist=/jffs/addons/zapret/hostlist.txt"
    fi

    if [ "$mode" = "tpws" ]; then
        if ! is_valid_port "$tpws_port"; then
            log_err "Error: Invalid tpws_port '$tpws_port'."
            return 1
        fi

        # Clean up opposing nfqws mode if switching directly via start
        if pidof nfqws >/dev/null 2>&1 || iptables -t mangle -S ZAPRET >/dev/null 2>&1; then
            killall nfqws 2>/dev/null || true
            rm -f "$PID_DIR/zapret_nfqws.pid"
            if [ -x /bin/runner ]; then
                /bin/runner enable 2>/dev/null || true
            fi
        fi
        iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1360 2>/dev/null || true
        iptables -t mangle -D FORWARD -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t mangle -D FORWARD -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t mangle -D PREROUTING -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t mangle -D PREROUTING -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t mangle -F ZAPRET 2>/dev/null || true
        iptables -t mangle -X ZAPRET 2>/dev/null || true

        # Check if tpws is already running
        if pidof tpws >/dev/null 2>&1; then
            echo "tpws is already running."
        else
            log_msg "Starting tpws on port $tpws_port..."
            local tpws_args_processed=$(echo "$tpws_args" | sed 's/--fooling=[^ ]*//g')
            set -f
            /opt/bin/tpws --port="$tpws_port" --bind-addr=127.0.0.1 $hostlist_arg $tpws_args_processed >/tmp/tpws.log 2>&1 389>&- &
            set +f
            echo $! > "$PID_DIR/zapret_tpws.pid"
            sleep 1
        fi

        if ! pidof tpws >/dev/null 2>&1; then
            log_err "Error: tpws failed to stay running. See /tmp/tpws.log"
            rm -f "$PID_DIR/zapret_tpws.pid"
            return 1
        fi
        
        # Apply iptables rules for tpws (nat redirect)
        echo "Applying iptables rules for tpws..."
        iptables -t nat -N ZAPRET 2>/dev/null
        iptables -t nat -F ZAPRET
        
        # Bypass VPN / WireGuard / Policy routing marked traffic and custom bypass ipsets
        iptables -t nat -A ZAPRET -m mark --mark 0x1000/0x1000 -j RETURN 2>/dev/null || true
        ipset list oracle_bypass >/dev/null 2>&1 && iptables -t nat -A ZAPRET -m set --match-set oracle_bypass dst -j RETURN 2>/dev/null || true
        [ -f /jffs/addons/zapret/custom-bypass.sh ] && /bin/sh /jffs/addons/zapret/custom-bypass.sh nat 2>/dev/null || true
        
        iptables -t nat -A ZAPRET -p tcp --dport 80 -j REDIRECT --to-ports "$tpws_port"
        iptables -t nat -A ZAPRET -p tcp --dport 443 -j REDIRECT --to-ports "$tpws_port"
        
        iptables -t nat -D PREROUTING -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t nat -D PREROUTING -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t nat -I PREROUTING -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET
        
    elif [ "$mode" = "nfqws" ]; then
        if ! is_valid_port "$nfqws_queue"; then
            log_err "Error: Invalid nfqws_queue '$nfqws_queue'."
            return 1
        fi

        # Clean up opposing tpws mode if switching directly via start
        if pidof tpws >/dev/null 2>&1; then
            killall tpws 2>/dev/null || true
            rm -f "$PID_DIR/zapret_tpws.pid"
        fi
        iptables -t nat -D PREROUTING -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t nat -D PREROUTING -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t nat -F ZAPRET 2>/dev/null || true
        iptables -t nat -X ZAPRET 2>/dev/null || true

        # Check if nfqws is already running
        if pidof nfqws >/dev/null 2>&1; then
            echo "nfqws is already running."
        else
            log_msg "Starting nfqws on queue $nfqws_queue..."
            local nfqws_args_processed=$(echo "$nfqws_args" | sed 's/--fooling=/--dpi-desync-fooling=/g')
            set -f
            /opt/bin/nfqws --qnum="$nfqws_queue" $hostlist_arg $nfqws_args_processed >/tmp/nfqws.log 2>&1 389>&- &
            set +f
            echo $! > "$PID_DIR/zapret_nfqws.pid"
            sleep 1
        fi

        if ! pidof nfqws >/dev/null 2>&1; then
            log_err "Error: nfqws failed to stay running. See /tmp/nfqws.log"
            rm -f "$PID_DIR/zapret_nfqws.pid"
            return 1
        fi
        
        # Apply iptables rules for nfqws (mangle NFQUEUE)
        echo "Applying iptables rules for nfqws..."
        iptables -t mangle -N ZAPRET 2>/dev/null
        iptables -t mangle -F ZAPRET
        
        # Bypass VPN / WireGuard / Policy routing marked traffic and custom bypass ipsets
        iptables -t mangle -A ZAPRET -m mark --mark 0x1000/0x1000 -j RETURN 2>/dev/null || true
        ipset list oracle_bypass >/dev/null 2>&1 && iptables -t mangle -A ZAPRET -m set --match-set oracle_bypass dst -j RETURN 2>/dev/null || true
        [ -f /jffs/addons/zapret/custom-bypass.sh ] && /bin/sh /jffs/addons/zapret/custom-bypass.sh mangle 2>/dev/null || true
        
        # Only inspect handshake/initial data packets (1:6) from client to avoid userspace overhead on ongoing data transfer
        iptables -t mangle -A ZAPRET -m connbytes --connbytes-dir original --connbytes-mode packets --connbytes 1:6 -p tcp --dport 80 -j NFQUEUE --queue-num "$nfqws_queue" --queue-bypass
        iptables -t mangle -A ZAPRET -m connbytes --connbytes-dir original --connbytes-mode packets --connbytes 1:6 -p tcp --dport 443 -j NFQUEUE --queue-num "$nfqws_queue" --queue-bypass
        
        iptables -t mangle -D FORWARD -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t mangle -D FORWARD -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t mangle -I FORWARD -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET
        iptables -t mangle -D PREROUTING -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
        iptables -t mangle -D PREROUTING -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true

        # Apply TCPMSS clamping rule to FORWARD chain (at top of chain) to prevent WAN MTU blackhole and nfqws EMSGSIZE errors
        iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1360 2>/dev/null || true
        iptables -t mangle -I FORWARD 1 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1360
    else
        log_err "Unknown mode: $mode"
        return 1
    fi
    log_msg "Zapret started successfully (mode=$mode, pids=$(pidof "$mode" 2>/dev/null))."
}

stop() {
    echo "Stopping Zapret processes..."
    killall tpws 2>/dev/null
    killall nfqws 2>/dev/null
    rm -f "$PID_DIR/zapret_tpws.pid" "$PID_DIR/zapret_nfqws.pid"

    # Re-enable Broadcom runner
    if [ -x /bin/runner ]; then
        echo "Re-enabling Broadcom packet runner..."
        /bin/runner enable 2>/dev/null || true
    fi
    
    echo "Cleaning up iptables rules..."
    iptables -t nat -D PREROUTING -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
    iptables -t nat -D PREROUTING -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
    iptables -t nat -F ZAPRET 2>/dev/null
    iptables -t nat -X ZAPRET 2>/dev/null
    
    iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss 1360 2>/dev/null || true
    iptables -t mangle -D FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || true
    iptables -t mangle -D FORWARD -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
    iptables -t mangle -D FORWARD -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
    iptables -t mangle -D PREROUTING -i br+ -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
    iptables -t mangle -D PREROUTING -i br0 -p tcp -m multiport --dports 80,443 -j ZAPRET 2>/dev/null || true
    iptables -t mangle -F ZAPRET 2>/dev/null
    iptables -t mangle -X ZAPRET 2>/dev/null
    
    log_msg "Zapret stopped."
}

status() {
    local tpws_pids=$(pidof tpws)
    local nfqws_pids=$(pidof nfqws)
    
    echo "=== Zapret Daemon Status ==="
    if [ -n "$tpws_pids" ]; then
        echo "tpws:  running (PID: $tpws_pids)"
    else
        echo "tpws:  stopped"
    fi
    
    if [ -n "$nfqws_pids" ]; then
        echo "nfqws: running (PID: $nfqws_pids)"
    else
        echo "nfqws: stopped"
    fi
    
    echo ""
    echo "=== iptables Active Rules ==="
    if iptables -t nat -S 2>/dev/null | grep -q "ZAPRET"; then
        echo "nat redirection rules: ACTIVE"
        iptables -t nat -S ZAPRET 2>/dev/null
    else
        echo "nat redirection rules: INACTIVE"
    fi
    
    if iptables -t mangle -S 2>/dev/null | grep -q "ZAPRET"; then
        echo "mangle queue rules: ACTIVE"
        iptables -t mangle -S ZAPRET 2>/dev/null
    else
        echo "mangle queue rules: INACTIVE"
    fi
}

webui() {
    # Find available slot (user1 to user20)
    local slot=""
    local i=1
    while [ $i -le 20 ]; do
        local title_file="/tmp/var/wwwext/user${i}.title"
        local asp_file="/tmp/var/wwwext/user${i}.asp"
        if [ ! -f "$title_file" ] && [ ! -f "$asp_file" ]; then
            slot="user${i}"
            break
        elif [ -f "$title_file" ] && [ "$(cat "$title_file")" = "Zapret" ]; then
            slot="user${i}"
            break
        fi
        i=$((i+1))
    done
    
    if [ -z "$slot" ]; then
        log_err "Error: No available WebUI slots (user1-user20) found."
        return 1
    fi
    
    echo "Injecting WebUI into slot: $slot"
    
    # Copy and configure WebUI ASP
    mkdir -p /tmp/var/wwwext
    if [ -f /jffs/addons/zapret/userpage_zapret.asp ]; then
        sed "s/%%USER_ASP%%/${slot}.asp/g" /jffs/addons/zapret/userpage_zapret.asp > /tmp/var/wwwext/${slot}.asp
        echo -n "Zapret" > /tmp/var/wwwext/${slot}.title
    else
        log_err "Error: /jffs/addons/zapret/userpage_zapret.asp not found."
        return 1
    fi
    
    # Generate WebUI JS config
    mkdir -p /tmp/var/wwwext/zapret
    if [ -f /jffs/addons/zapret/config.json ]; then
        echo -n "var zapret_config = " > /tmp/var/wwwext/zapret/config.js
        cat /jffs/addons/zapret/config.json >> /tmp/var/wwwext/zapret/config.js
        echo ";" >> /tmp/var/wwwext/zapret/config.js
    else
        echo "var zapret_config = {enabled: \"0\", mode: \"nfqws\", tpws_enabled: \"0\", tpws_port: \"10080\", tpws_args: \"--fooling=md5sig\", nfqws_enabled: \"0\", nfqws_args: \"--dpi-desync=multisplit --dpi-desync-fooling=md5sig --dpi-desync-cutoff=d4\", nfqws_queue: \"200\", hostlist_mode: \"all\"};" > /tmp/var/wwwext/zapret/config.js
    fi
    
    # Link hostlist file for WebUI access (using .json extension since .txt is blocked by httpd)
    rm -f /tmp/var/wwwext/zapret/hostlist.json /tmp/var/wwwext/zapret/hostlist.txt
    if [ -f /jffs/addons/zapret/hostlist.txt ]; then
        ln -sf /jffs/addons/zapret/hostlist.txt /tmp/var/wwwext/zapret/hostlist.json
    else
        touch /tmp/var/wwwext/zapret/hostlist.json
    fi
    
    # Lock to safely coordinate with other Asuswrt-Merlin addons
    local lockfile="/tmp/addonwebui.lock"
    local fd=388
    eval exec "$fd>$lockfile"
    flock -x "$fd"

    # Base on existing /tmp/menuTree.js to preserve other addons, or initialize from stock
    if [ ! -f /tmp/menuTree.js ]; then
        cp -fp /www/require/modules/menuTree.js /tmp/menuTree.js
    fi

    # Clean up any existing Zapret entry to prevent duplicates
    sed -i '/tabName: "Zapret"/d' /tmp/menuTree.js

    # Inject into menuTree.js after NATPassThrough tab (menu_WAN)
    awk -v slot="${slot}.asp" '
    {
        print $0
        if ($0 ~ /Advanced_NATPassThrough_Content.asp/) {
            print "\t\t{url: \"" slot "\", tabName: \"Zapret\"},"
        }
    }' /tmp/menuTree.js > /tmp/menuTree.js.tmp && mv /tmp/menuTree.js.tmp /tmp/menuTree.js

    # Re-apply bind mount
    umount /www/require/modules/menuTree.js 2>/dev/null || true
    mount --bind /tmp/menuTree.js /www/require/modules/menuTree.js

    flock -u "$fd"
    eval exec "$fd>&-"
    fix_perms >/dev/null 2>&1 || true
    
    log_msg "Mounted Zapret WebUI page as ${slot}.asp"
}

service_event() {
    if [ ! -f "$CONFIG_FILE" ]; then
        mkdir -p /jffs/addons/zapret
        cat <<EOF > "$CONFIG_FILE"
{
  "enabled": "0",
  "mode": "nfqws",
  "tpws_enabled": "0",
  "tpws_port": "10080",
  "tpws_args": "--fooling=md5sig",
  "nfqws_enabled": "0",
  "nfqws_args": "--dpi-desync=multisplit --dpi-desync-fooling=md5sig --dpi-desync-cutoff=d4",
  "nfqws_queue": "200",
  "hostlist_mode": "all"
}
EOF
    fi
    
    if [ -f /jffs/addons/custom_settings.txt ] && grep -q "^zapret_" /jffs/addons/custom_settings.txt; then
        local enabled=$(get_json_val "enabled" "$CONFIG_FILE")
        local mode=$(get_json_val "mode" "$CONFIG_FILE")
        local tpws_enabled=$(get_json_val "tpws_enabled" "$CONFIG_FILE")
        local tpws_port=$(get_json_val "tpws_port" "$CONFIG_FILE")
        local tpws_args=$(get_json_val "tpws_args" "$CONFIG_FILE")
        local nfqws_enabled=$(get_json_val "nfqws_enabled" "$CONFIG_FILE")
        local nfqws_args=$(get_json_val "nfqws_args" "$CONFIG_FILE")
        local nfqws_queue=$(get_json_val "nfqws_queue" "$CONFIG_FILE")
        local hostlist_mode=$(get_json_val "hostlist_mode" "$CONFIG_FILE")
        local hostlist_raw=""
        
        while read -r key val || [ -n "$key" ]; do
            case "$key" in
                zapret_enabled) enabled="$val" ;;
                zapret_mode) mode="$val" ;;
                zapret_tpws_enabled) tpws_enabled="$val" ;;
                zapret_tpws_port) tpws_port="$val" ;;
                zapret_tpws_args) tpws_args="$val" ;;
                zapret_nfqws_enabled) nfqws_enabled="$val" ;;
                zapret_nfqws_args) nfqws_args="$val" ;;
                zapret_nfqws_queue) nfqws_queue="$val" ;;
                zapret_hostlist_mode) hostlist_mode="$val" ;;
                zapret_hostlist_raw) hostlist_raw="$val" ;;
            esac
        done < /jffs/addons/custom_settings.txt
        
        # Remove our keys from custom_settings.txt
        grep -v "^zapret_" /jffs/addons/custom_settings.txt > /tmp/custom_settings.txt.tmp
        mv /tmp/custom_settings.txt.tmp /jffs/addons/custom_settings.txt
        
        # Rewrite config.json (escape values to preserve valid JSON/JS)
        cat <<EOF > "$CONFIG_FILE"
{
  "enabled": "$(json_escape "$enabled")",
  "mode": "$(json_escape "$mode")",
  "tpws_enabled": "$(json_escape "$tpws_enabled")",
  "tpws_port": "$(json_escape "$tpws_port")",
  "tpws_args": "$(json_escape "$tpws_args")",
  "nfqws_enabled": "$(json_escape "$nfqws_enabled")",
  "nfqws_args": "$(json_escape "$nfqws_args")",
  "nfqws_queue": "$(json_escape "$nfqws_queue")",
  "hostlist_mode": "$(json_escape "$hostlist_mode")"
}
EOF

        # Handle host list
        if [ "$hostlist_mode" = "custom" ]; then
            local parsed_hosts=$(echo "$hostlist_raw" | tr -d '\r' | tr ',' '\n' | tr 'A-Z' 'a-z' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | sed '/^$/d' | sort -u)
            local cur_hosts=$(count_hosts "/jffs/addons/zapret/hostlist.txt")

            if [ -n "$parsed_hosts" ]; then
                # Back up existing hostlist before overwriting
                if [ "$cur_hosts" -gt 0 ] 2>/dev/null; then
                    cp -f /jffs/addons/zapret/hostlist.txt /jffs/addons/zapret/hostlist.txt.bak
                fi
                echo "$parsed_hosts" > /jffs/addons/zapret/hostlist.txt
            else
                if [ "$cur_hosts" -gt 0 ] 2>/dev/null; then
                    echo "Warning: hostlist_raw is empty but hostlist.txt has entries; preserving hostlist.txt." >&2
                    logger -t zapret "service_event: hostlist_raw is empty, preserving existing hostlist.txt ($cur_hosts domains)"
                    if [ ! -f /jffs/addons/zapret/hostlist.txt.bak ]; then
                        cp -f /jffs/addons/zapret/hostlist.txt /jffs/addons/zapret/hostlist.txt.bak
                    fi
                else
                    local bak_hosts=$(count_hosts "/jffs/addons/zapret/hostlist.txt.bak")
                    if [ "$bak_hosts" -gt 0 ] 2>/dev/null; then
                        echo "Warning: hostlist_raw is empty and hostlist.txt is empty; restoring from hostlist.txt.bak ($bak_hosts domains)." >&2
                        logger -t zapret "service_event: restoring hostlist.txt from hostlist.txt.bak ($bak_hosts domains)"
                        cp -f /jffs/addons/zapret/hostlist.txt.bak /jffs/addons/zapret/hostlist.txt
                    fi
                fi
            fi
        fi
        fix_perms >/dev/null 2>&1 || true
    fi
    
    # Apply new settings
    log_msg "Applying configuration via service_event..."
    stop
    start
    webui
}

menu_colors() {
    if [ -t 1 ]; then
        C_RESET='\033[0m'
        C_BOLD='\033[1m'
        C_DIM='\033[2m'
        C_RED='\033[31m'
        C_GREEN='\033[32m'
        C_YELLOW='\033[33m'
        C_BLUE='\033[34m'
        C_CYAN='\033[36m'
        C_WHITE='\033[37m'
        C_BG_GREEN='\033[42;30m'
        C_BG_RED='\033[41;37m'
        C_BG_BLUE='\033[44;37m'
    else
        C_RESET=''; C_BOLD=''; C_DIM=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''; C_CYAN=''; C_WHITE=''
        C_BG_GREEN=''; C_BG_RED=''; C_BG_BLUE=''
    fi
}

badge() {
    local color="$1"
    local text="$2"
    printf "%b %-7s %b" "$color" "$text" "$C_RESET"
}

menu_row() {
    local key="$1"
    local title="$2"
    local desc="$3"
    printf "  %b%-4s%b %-24s %b%s%b\n" "$C_BG_BLUE" "$key" "$C_RESET" "$title" "$C_DIM" "$desc" "$C_RESET"
}

amtm_menu_header() {
    local enabled mode daemon
    enabled=$(get_json_val "enabled" "$CONFIG_FILE")
    mode=$(get_json_val "mode" "$CONFIG_FILE")
    [ -n "$mode" ] || mode="unknown"

    if pidof nfqws >/dev/null 2>&1; then
        daemon="nfqws"
    elif pidof tpws >/dev/null 2>&1; then
        daemon="tpws"
    else
        daemon="stopped"
    fi

    clear 2>/dev/null || true
    printf "%b╔══════════════════════════════════════════════════════╗%b\n" "$C_CYAN" "$C_RESET"
    printf "%b║%b  %bZapret Asuswrt-Merlin%b                         %b║%b\n" "$C_CYAN" "$C_RESET" "$C_BOLD$C_WHITE" "$C_RESET" "$C_CYAN" "$C_RESET"
    printf "%b║%b  DPI bypass control panel                         %b║%b\n" "$C_CYAN" "$C_DIM" "$C_CYAN" "$C_RESET"
    printf "%b╚══════════════════════════════════════════════════════╝%b\n\n" "$C_CYAN" "$C_RESET"

    printf "  Status   : "
    if [ "$enabled" = "1" ]; then badge "$C_BG_GREEN" "ENABLED"; else badge "$C_BG_RED" "DISABLED"; fi
    printf "   Mode: %b%s%b   Daemon: %b%s%b\n\n" "$C_YELLOW" "$mode" "$C_RESET" "$C_YELLOW" "$daemon" "$C_RESET"
}

with_lock() {
    local lockfile="/tmp/zapret.lock"
    exec 389>"$lockfile"
    flock -x 389
    "$@"
    local rc=$?
    flock -u 389
    exec 389>&-
    return $rc
}

restart_service() {
    stop
    start
}

amtm_menu() {
    menu_colors
    while true; do
        amtm_menu_header
        printf "%b Actions%b\n" "$C_BOLD" "$C_RESET"
        menu_row "1"  "Status details"       "show daemons and iptables rules"
        menu_row "2"  "Start zapret"         "start current configured mode"
        menu_row "3"  "Stop zapret"          "stop daemons and remove rules"
        menu_row "4"  "Restart zapret"       "clean restart"
        menu_row "5"  "Re-inject WebUI"      "restore WAN tab after httpd restart"
        menu_row "6"  "Fix permissions"      "harden zapret files and WebUI cache"
        printf "\n  %be%b    Exit\n" "$C_BG_BLUE" "$C_RESET"
        printf "\n%bChoose option:%b " "$C_BOLD" "$C_RESET"
        read choice
        echo
        case "$choice" in
            1) status ;;
            2) with_lock start ;;
            3) with_lock stop ;;
            4) with_lock restart_service ;;
            5) webui; fix_perms ;;
            6) fix_perms ;;
            [Ee]) return 0 ;;
            *) echo "Invalid option." ;;
        esac
        printf "\n%bPress Enter to continue...%b" "$C_DIM" "$C_RESET"
        read dummy
    done
}

case "${1:-menu}" in
    menu|"")
        amtm_menu
        ;;
    start)
        with_lock start
        ;;
    stop)
        with_lock stop
        ;;
    restart)
        with_lock restart_service
        ;;
    status)
        status
        ;;
    webui)
        webui
        ;;
    service_event)
        with_lock service_event
        ;;
    fix_perms)
        fix_perms
        ;;
    *)
        echo "Usage: $0 {menu|start|stop|restart|status|webui|service_event|fix_perms}"
        exit 1
        ;;
esac
